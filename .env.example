# ==========================================
# E-COMMERCE MONOREPO GLOBAL ENVIRONMENT
# ==========================================
# This file contains the environment configuration for all services in the monorepo.
# During deployment (e.g. Docker Compose), this file can be used to inject all variables.

# ==========================================
# GLOBAL APP SETTINGS
# ==========================================
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ==========================================
# PORTS FOR EACH MICROSERVICE
# ==========================================
WEB_PORT=3000
AUTH_PORT=4001
PRODUCT_PORT=4002
ORDER_PORT=4003
PAYMENT_PORT=4004
CHAT_PORT=4005
EMAIL_PORT=4006

# ==========================================
# MONGODB URIs FOR EACH MICROSERVICE
# ==========================================
# Note: In a real production setup, these could be the same DB cluster with different DB names.
AUTH_MONGO_URI=
PRODUCT_MONGO_URI=
ORDER_MONGO_URI=
PAYMENT_MONGO_URI=
CHAT_MONGO_URI=

# ==========================================
# MESSAGE BROKERS & CACHING
# ==========================================
RABBITMQ_URL=
REDIS_URL=

# ==========================================
# SECURITY & JWT (AUTH SERVICE)
# ==========================================
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ==========================================
# PAYMENT GATEWAYS (PAYMENT SERVICE
# ==========================================
# Stripe Config
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ==========================================
# IMAGE UPLOAD (IMAGEKIT)
# ==========================================
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
# ==========================================
# FRONTEND CONFIG (NEXT.JS)
# ==========================================
NEXT_PUBLIC_CHAT_SERVICE_URL=
NEXT_PUBLIC_AUTH_SERVICE_URL=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

RABBITMQ_URL_PROD=